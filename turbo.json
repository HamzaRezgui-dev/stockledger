{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "target/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "target/surefire-reports/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["target/failsafe-reports/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": ["compose.yaml", ".env"],
  "globalEnv": ["STOCKLEDGER_API_URL", "STOCKLEDGER_ACTOR"]
}
